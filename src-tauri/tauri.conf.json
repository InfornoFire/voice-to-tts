{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "voice-to-tts",
  "version": "0.1.0",
  "identifier": "com.inforno.voice-to-tts",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "voice-to-tts",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "publisher": "Inforno",
    "copyright": "Copyright © 2026 Inforno",
    "license": "MIT",
    "homepage": "https://github.com/InfornoFire/voice-to-tts",
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "silent": true,
        "type": "embedBootstrapper"
      },
      "wix": {
        "fipsCompliant": true,
        "language": "en-US"
      }
    }
  }
}
